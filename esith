<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ESITH Protocol — Dynamic USD/ETH Payment Gateway</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/ethers/6.7.0/ethers.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #06080d;
            --card-bg: rgba(15, 21, 37, 0.85);
            --border-color: rgba(255, 255, 255, 0.08);
            --border-highlight: rgba(99, 102, 241, 0.3);
            --primary-accent: #6366f1;
            --secondary-accent: #06b6d4;
            --success-color: #10b981;
            --primary-gradient: linear-gradient(135deg, #6366f1 0%, #06b6d4 100%);
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Plus Jakarta Sans', sans-serif; }
        body { background-color: var(--bg-color); color: var(--text-main); min-height: 100vh; display: flex; flex-direction: column; align-items: center; padding: 12px; }
        .mono { font-family: 'JetBrains Mono', monospace; }
        
        header { width: 100%; max-width: 1100px; display: flex; flex-direction: row; justify-content: space-between; align-items: center; padding: 16px 0; border-bottom: 1px solid var(--border-color); margin-bottom: 20px; gap: 10px; }
        .logo { font-size: 1.2rem; font-weight: 800; background: var(--primary-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        
        .container { width: 100%; max-width: 1100px; display: grid; gap: 20px; }
        .hero { text-align: center; margin-bottom: 5px; padding: 0 10px; }
        .hero h1 { font-size: 1.8rem; font-weight: 800; margin-bottom: 8px; }
        .hero p { color: var(--text-muted); font-size: 0.9rem; line-height: 1.4; }

        .main-grid { display: grid; grid-template-columns: 1fr; gap: 20px; }
        @media(min-width: 850px) { .main-grid { grid-template-columns: 1.1fr 0.9fr; } }

        .card { background: var(--card-bg); border: 1px solid var(--border-color); backdrop-filter: blur(20px); border-radius: 20px; padding: 20px; box-shadow: 0 12px 40px rgba(0,0,0,0.5); }
        @media(min-width: 600px) { .card { padding: 28px; border-radius: 24px; } }

        .card-title { font-size: 1.1rem; font-weight: 700; margin-bottom: 16px; display: flex; justify-content: space-between; align-items: center; }
        .stats-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-bottom: 20px; }
        .stat-box { background: rgba(0, 0, 0, 0.3); padding: 14px; border-radius: 14px; border: 1px solid var(--border-color); }
        .stat-box span { display: block; color: var(--text-muted); font-size: 0.7rem; font-weight: 600; text-transform: uppercase; margin-bottom: 4px; }
        .stat-box strong { font-size: 1.05rem; color: #fff; word-break: break-all; }

        .form-group { margin-bottom: 16px; }
        label { display: block; margin-bottom: 6px; color: var(--text-muted); font-weight: 600; font-size: 0.8rem; }
        input { width: 100%; background: rgba(0, 0, 0, 0.4); border: 1px solid var(--border-color); border-radius: 12px; padding: 12px 14px; color: #fff; font-size: 0.9rem; outline: none; }
        input:focus { border-color: var(--primary-accent); }

        .btn { width: 100%; background: var(--primary-gradient); color: white; border: none; padding: 14px; border-radius: 12px; font-weight: 700; font-size: 0.95rem; cursor: pointer; transition: opacity 0.2s; margin-top: 6px; }
        .btn:hover { opacity: 0.9; }
        .btn-secondary { background: rgba(255, 255, 255, 0.06); border: 1px solid var(--border-color); }

        .tab-nav { display: flex; gap: 6px; margin-bottom: 16px; background: rgba(0,0,0,0.3); padding: 4px; border-radius: 10px; border: 1px solid var(--border-color); }
        .tab-btn { flex: 1; padding: 8px; background: transparent; border: none; border-radius: 6px; color: var(--text-muted); font-weight: 600; font-size: 0.85rem; cursor: pointer; }
        .tab-btn.active { background: var(--primary-accent); color: #fff; }

        .tx-history { display: flex; flex-direction: column; gap: 8px; max-height: 180px; overflow-y: auto; }
        .tx-item { display: flex; justify-content: space-between; align-items: center; background: rgba(0,0,0,0.25); padding: 10px 14px; border-radius: 10px; border: 1px solid var(--border-color); font-size: 0.8rem; gap: 10px; }
        .tx-in { color: var(--success-color); font-weight: 700; }
        .tx-out { color: var(--primary-accent); font-weight: 700; }
        
        #statusMessage { margin-top: 12px; padding: 12px; border-radius: 12px; font-size: 0.85rem; text-align: center; display: none; word-break: break-all; }

        .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(3, 7, 18, 0.85); backdrop-filter: blur(10px); display: none; justify-content: center; align-items: center; z-index: 1000; padding: 12px; }
        .modal-content { background: #0f1525; border: 1px solid var(--border-highlight); width: 100%; max-width: 440px; border-radius: 20px; padding: 24px; box-shadow: 0 20px 50px rgba(0,0,0,0.7); }
        
        .terminal-box { background: #030712; border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; padding: 10px; font-size: 0.75rem; color: #34d399; margin-top: 12px; max-height: 90px; overflow-y: auto; }

        /* Cinematic project presentation */
        .presentation-overlay { position:fixed; inset:0; z-index:2000; display:none; align-items:center; justify-content:center; padding:18px; background:radial-gradient(circle at 15% 15%, rgba(99,102,241,.22), transparent 35%), rgba(2,6,18,.97); }
        .presentation-shell { width:min(1100px, 100%); height:min(720px, 92vh); display:flex; flex-direction:column; border:1px solid rgba(129,140,248,.35); border-radius:24px; overflow:hidden; background:linear-gradient(145deg, rgba(15,21,37,.98), rgba(5,10,24,.98)); box-shadow:0 30px 100px rgba(0,0,0,.65); }
        .presentation-top { display:flex; justify-content:space-between; align-items:center; padding:16px 22px; border-bottom:1px solid var(--border-color); color:var(--text-muted); font-size:.78rem; }
        .slide-stage { position:relative; flex:1; display:flex; align-items:center; padding:clamp(24px,6vw,76px); overflow:hidden; }
        .slide { width:100%; animation:slideReveal .55s cubic-bezier(.2,.8,.2,1); }
        .slide-kicker { color:#67e8f9; text-transform:uppercase; letter-spacing:.2em; font-size:.72rem; font-weight:800; margin-bottom:18px; }
        .slide h2 { font-size:clamp(2rem,5vw,4.6rem); line-height:1.04; letter-spacing:-.05em; margin-bottom:20px; max-width:850px; }
        .slide p { color:#cbd5e1; font-size:clamp(.95rem,1.6vw,1.2rem); line-height:1.75; max-width:780px; }
        .slide-points { display:grid; grid-template-columns:repeat(auto-fit,minmax(190px,1fr)); gap:12px; margin-top:28px; }
        .slide-point { padding:16px; border:1px solid rgba(148,163,184,.18); background:rgba(15,23,42,.7); border-radius:16px; color:#e2e8f0; line-height:1.5; }
        .slide-point b { display:block; color:#a5b4fc; margin-bottom:6px; }
        .slide-visual { display:flex; flex-wrap:wrap; align-items:center; gap:12px; margin-top:30px; }
        .node { padding:13px 17px; border:1px solid rgba(103,232,249,.45); border-radius:14px; background:rgba(6,182,212,.1); color:#cffafe; font-family:'JetBrains Mono',monospace; font-size:.8rem; animation:nodePulse 2.4s infinite; }
        .node:nth-child(2) { animation-delay:.35s; } .node:nth-child(3) { animation-delay:.7s; }
        .slide-controls { display:flex; align-items:center; gap:10px; padding:14px 20px; border-top:1px solid var(--border-color); }
        .slide-controls .btn { width:auto; min-width:105px; margin:0; padding:10px 16px; }
        .slide-progress { height:3px; background:rgba(255,255,255,.08); flex:1; border-radius:99px; overflow:hidden; }
        .slide-progress span { display:block; height:100%; width:0; background:var(--primary-gradient); transition:width .35s ease; }
        #slideCounter { color:var(--text-muted); font: .75rem 'JetBrains Mono',monospace; min-width:48px; text-align:center; }
        @keyframes slideReveal { from {opacity:0; transform:translateY(18px) scale(.985)} to {opacity:1; transform:translateY(0) scale(1)} }
        @keyframes nodePulse { 0%,100% {box-shadow:0 0 0 rgba(6,182,212,0)} 50% {box-shadow:0 0 24px rgba(6,182,212,.18)} }
        @media(max-width:600px) { .presentation-overlay {padding:6px} .presentation-shell {height:96vh;border-radius:16px} .presentation-top {padding:12px} .slide-stage {padding:24px} .slide-controls {padding:10px} .slide-controls .btn {min-width:78px;font-size:.75rem} }

    </style>
</head>
<body>

    <header>
        <div class="logo">⚡ ESITH Protocol</div>
        <div style="display:flex; align-items:center; gap:10px;">
            <button class="btn btn-secondary" style="width:auto; padding:8px 12px; margin:0; font-size:.75rem;" onclick="openPresentation()">▶ Project Presentation</button>
            <div id="headerBadge">
                <span style="color: var(--text-muted); font-size: 0.75rem;">Wallet Locked</span>
            </div>
        </div>
    </header>

    <div class="container">
        <div class="hero">
            <h1>Decentralized Token Launchpad</h1>
            <p>Dynamic Dynamic USD/ETH Calculation Gateway</p>
        </div>

        <div class="main-grid" id="appInterface" style="display:none;">
            <!-- Minting Card -->
            <div class="card">
                <div class="card-title">🚀 Token Presale</div>
                <div class="stats-grid">
                    <div class="stat-box"><span>Mint Fee</span><strong style="color: var(--secondary-accent);">0.0001 ETH</strong></div>
                    <div class="stat-box"><span>Sepolia ETH</span><strong id="ethBalanceDisplay" class="mono" style="color: #38bdf8;">0.50 ETH</strong></div>
                </div>
                <button class="btn btn-secondary" onclick="openGatewayModal()" style="margin-bottom: 16px; border-color: var(--secondary-accent); color: var(--secondary-accent);">
                    💳 Virtual Top-Up (<span id="presaleBtnUsd">$3,186.08</span>)
                </button>

                <div class="form-group">
                    <label>Purchase Quantity</label>
                    <input type="number" id="tokenAmount" value="50" min="1">
                </div>
                <button class="btn" onclick="openSignModal()">Mint ESITH (Sign TX)</button>
            </div>

            <!-- Wallet Dashboard Card -->
            <div class="card">
                <div class="card-title">
                    <span>👛 Web3 Wallet</span>
                    <button class="btn btn-secondary" style="width:auto; padding:4px 10px; font-size:0.7rem;" onclick="logoutWallet()">Switch</button>
                </div>
                <div class="stats-grid">
                    <div class="stat-box"><span>Active Address</span><strong id="walletAddressDisplay" class="mono" style="font-size: 0.65rem;">0x...</strong></div>
                    <div class="stat-box" style="grid-column: span 2; background: rgba(99, 102, 241, 0.08);">
                        <span>ESITH Balance</span>
                        <strong id="esithBalanceDisplay" class="mono" style="color: #34d399; font-size: 1.2rem;">Fetching...</strong>
                    </div>
                </div>

                <div class="tab-nav">
                    <button class="tab-btn active" onclick="switchTab('transfer')">Send P2P</button>
                    <button class="tab-btn" onclick="switchTab('history')">History</button>
                </div>

                <div id="transferTab">
                    <div class="form-group">
                        <div style="display:flex; justify-content:space-between; margin-bottom:4px;">
                            <label>Recipient Address</label>
                            <a href="javascript:void(0)" onclick="generateTestRecipient()" style="color:#818cf8; font-size:0.7rem; text-decoration:none;">🎲 Generate Contact</a>
                        </div>
                        <input type="text" id="recipientAddress" class="mono" placeholder="0x...">
                    </div>
                    <div class="form-group">
                        <label>Amount to Send</label>
                        <input type="number" id="transferAmount" value="5" min="0.1">
                    </div>
                    <button class="btn" id="sendButton">Transfer ESITH Live</button>
                </div>

                <div id="historyTab" style="display:none;">
                    <div class="tx-history" id="txHistoryContainer">
                        <div style="text-align: center; padding: 12px; color: var(--text-muted); font-size: 0.8rem;">Loading logs...</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Setup Card -->
        <div class="card" id="setupCard" style="max-width: 440px; margin: 0 auto; text-align: center;">
            <div class="card-title" style="justify-content: center;">Access Web3 Wallet</div>
            <p style="color: var(--text-muted); margin-bottom: 16px; font-size: 0.85rem;">Generate a fresh mobile-friendly wallet or import a private key.</p>
            <button class="btn" onclick="createNewWallet()">Generate New Wallet</button>
            <button class="btn btn-secondary" onclick="importWalletPrompt()">🔑 Restore Existing Wallet</button>
        </div>

        <div id="statusMessage"></div>
    </div>

    <!-- Secure Virtual Gateway Modal -->
    <div class="modal-overlay" id="gatewayModal">
        <div class="modal-content">
            <div class="card-title" style="margin-bottom: 12px;">
                <span>🔒 Virtual Payment Gateway</span>
                <span style="cursor:pointer; color:var(--text-muted); font-size:1.1rem;" onclick="closeGatewayModal()">&times;</span>
            </div>
            <div class="form-group">
                <label>Card Number</label>
                <input type="text" class="mono" value="5412 7500 3489 1234" readonly>
            </div>
            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:10px;">
                <div class="form-group">
                    <label>Expiry</label>
                    <input type="text" class="mono" value="09/28" readonly>
                </div>
                <div class="form-group">
                    <label>CVV</label>
                    <input type="text" class="mono" value="•••" readonly>
                </div>
            </div>
            <div class="form-group">
                <label>Amount of ETH to Top-Up</label>
                <input type="number" id="gatewayEthAmount" value="1.5" min="0.1" step="0.1" oninput="updateGatewayUsdTotal()">
            </div>
            <button class="btn" id="payNowBtn" onclick="executeVirtualPayment()">
                Authorize <span id="gatewayUsdDisplay">$3,186.08</span> USD via Mastercard
            </button>
            <div class="terminal-box mono" id="terminalLog">
                [SYSTEM] Gateway initialized. Live market rate loaded.<br>
                [RATE] 1 ETH = $2,124.05 USD
            </div>
        </div>
    </div>

    <!-- Signature Modal -->
    <div class="modal-overlay" id="signModal">
        <div class="modal-content">
            <div class="card-title" style="margin-bottom: 12px;">
                <span>✍️ Signature Request</span>
                <span style="cursor:pointer; color:var(--text-muted); font-size:1.1rem;" onclick="closeSignModal()">&times;</span>
            </div>
            <p style="color:var(--text-muted); font-size:0.8rem; margin-bottom:12px;">Approve signature to execute smart contract mint.</p>
            <div class="stat-box" style="margin-bottom: 14px;">
                <span>Payload</span>
                <strong id="signPayloadSummary" class="mono" style="font-size:0.75rem; color:#818cf8;">Minting 50 ESITH</strong>
            </div>
            <div style="display:flex; gap:10px;">
                <button class="btn btn-secondary" onclick="closeSignModal()">Reject</button>
                <button class="btn" id="signConfirmBtn" onclick="executeSignedMint()">Sign & Broadcast</button>
            </div>
        </div>
    </div>

    <!-- PowerPoint-style presentation -->
    <div class="presentation-overlay" id="presentationOverlay" role="dialog" aria-modal="true" aria-label="ESITH project presentation">
        <div class="presentation-shell">
            <div class="presentation-top">
                <span>⚡ ESITH PROTOCOL · PROJECT BRIEFING</span>
                <button class="btn btn-secondary" style="width:auto;margin:0;padding:6px 10px;font-size:.75rem;" onclick="closePresentation()">✕ Close</button>
            </div>
            <div class="slide-stage"><div class="slide" id="slideContent"></div></div>
            <div class="slide-controls">
                <button class="btn btn-secondary" onclick="previousSlide()">← Back</button>
                <div class="slide-progress"><span id="slideProgress"></span></div>
                <span id="slideCounter">1 / 7</span>
                <button class="btn" onclick="nextSlide()">Next →</button>
            </div>
        </div>
    </div>

    <script>
        let currentWallet = null;
        let syncInterval = null;
        let cachedEsithBalance = 0;
        let cachedEthBalance = 0;
        const TOKEN_FEE_ETH = 0.0001;
        const ETH_USD_RATE = 2124.05; // Demo rate only; replace with a trusted price feed for production.

        // Public demo API: no administrator access key is required.
        async function apiFetch(url, options = {}) {
            return fetch(url, options);
        }

        function updateGatewayUsdTotal() {
            const ethInput = document.getElementById("gatewayEthAmount");
            const usdDisplay = document.getElementById("gatewayUsdDisplay");
            const presaleBtnUsd = document.getElementById("presaleBtnUsd");

            let ethAmount = parseFloat(ethInput.value);
            if (isNaN(ethAmount) || ethAmount <= 0) ethAmount = 0;

            const totalUsdStr = "$" + (ethAmount * ETH_USD_RATE).toLocaleString('en-US', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });

            if (usdDisplay) usdDisplay.innerText = totalUsdStr;
            if (presaleBtnUsd) presaleBtnUsd.innerText = totalUsdStr;
        }

        function playSuccessChime() {
            try {
                const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(587.33, audioCtx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(880, audioCtx.currentTime + 0.15);
                gain.gain.setValueAtTime(0.15, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.6);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.6);
            } catch(e) {}
        }

        window.addEventListener("DOMContentLoaded", async () => {
            updateGatewayUsdTotal();
            const savedKey = localStorage.getItem("esith_db_wallet_pk");
            if (savedKey) {
                try {
                    currentWallet = new ethers.Wallet(savedKey);
                    await activateWalletUI();
                } catch(e) {}
            }
        });

        async function createNewWallet() {
            const wallet = ethers.Wallet.createRandom();
            await loginWallet(wallet.privateKey);
        }

        async function importWalletPrompt() {
            const pk = prompt("Enter your wallet recovery private key (starting with 0x):");
            if (!pk) return;
            try {
                const wallet = new ethers.Wallet(pk.trim());
                await loginWallet(wallet.privateKey);
                showStatus("Wallet successfully restored!", "success");
            } catch(e) {
                alert("Invalid recovery key. Please check the key and try again.");
            }
        }

        async function loginWallet(privateKey) {
            const wallet = new ethers.Wallet(privateKey);
            localStorage.setItem("esith_db_wallet_pk", wallet.privateKey);
            currentWallet = wallet;
            await apiFetch('/api/register-wallet', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ address: wallet.address })
            });
            await activateWalletUI();
            showStatus("Wallet connected!", "success");
        }

        function logoutWallet() {
            if (syncInterval) clearInterval(syncInterval);
            localStorage.removeItem("esith_db_wallet_pk");
            currentWallet = null;
            document.getElementById("setupCard").style.display = "block";
            document.getElementById("appInterface").style.display = "none";
            document.getElementById("headerBadge").innerHTML = `<span style="color: var(--text-muted); font-size: 0.75rem;">Wallet Locked</span>`;
            showStatus("Logged out.", "info");
        }

        async function activateWalletUI() {
            document.getElementById("setupCard").style.display = "none";
            document.getElementById("appInterface").style.display = "grid";
            document.getElementById("walletAddressDisplay").innerText = currentWallet.address;
            document.getElementById("headerBadge").innerHTML = `
                <div style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.3); color: var(--success-color); padding: 4px 10px; border-radius: 10px; font-weight: 700; font-size: 0.75rem;">
                    🟢 Synced
                </div>
            `;
            await syncDatabaseState();
            if (syncInterval) clearInterval(syncInterval);
            syncInterval = setInterval(syncDatabaseState, 2000);
        }

        async function syncDatabaseState() {
            if (!currentWallet) return;
            try {
                const res = await apiFetch(`/api/wallet-state/${currentWallet.address}`);
                const data = await res.json();
                if (!res.ok || data.status !== "success") {
                    throw new Error(data.message || `Wallet refresh failed (${res.status}).`);
                }
                cachedEsithBalance = Number(data.esith_balance || 0);
                cachedEthBalance = Number(data.eth_balance || 0);
                    document.getElementById("esithBalanceDisplay").innerText = `${cachedEsithBalance.toLocaleString()} ESITH`;
                    document.getElementById("ethBalanceDisplay").innerText = `${cachedEthBalance.toFixed(4)} ETH`;
                    
                    const container = document.getElementById("txHistoryContainer");
                    if (data.history.length > 0) {
                        container.innerHTML = "";
                        data.history.forEach(tx => {
                            const isIncoming = tx.is_incoming;
                            const item = document.createElement("div");
                            item.className = "tx-item";
                            let label = tx.tx_type === 'MINT' ? '↓ Minted' : (tx.tx_type === 'TOPUP' ? '💳 Top-Up' : (isIncoming ? '↓ Received' : '↑ Sent'));
                            item.innerHTML = `
                                <div>
                                    <div class="${isIncoming ? 'tx-in' : 'tx-out'}">${label}</div>
                                    <div style="color: var(--text-muted); font-size: 0.65rem;" class="mono">${tx.tx_hash.substring(0, 10)}...</div>
                                </div>
                                <div class="mono">${isIncoming ? '+' : '-'}${tx.amount} ${tx.tx_type === 'TOPUP' ? 'ETH' : 'ESITH'}</div>
                            `;
                            container.appendChild(item);
                        });
                    } else {
                        container.innerHTML = `<div style="text-align: center; padding: 12px; color: var(--text-muted); font-size: 0.8rem;">No transactions yet.</div>`;
                    }
                return true;
            } catch (e) {
                console.error("Wallet refresh failed:", e);
                return false;
            }
        }

        function openGatewayModal() { 
            updateGatewayUsdTotal();
            document.getElementById("gatewayModal").style.display = "flex"; 
        }
        function closeGatewayModal() { document.getElementById("gatewayModal").style.display = "none"; }
        
        async function openSignModal() {
            const amount = Number(document.getElementById("tokenAmount").value);
            if (!currentWallet) return showStatus("Connect a wallet first.", "error");
            if (!Number.isFinite(amount) || amount <= 0) return alert("Enter a valid token quantity.");

            // Always read the latest server-side balance before checking the fee.
            const balanceLoaded = await syncDatabaseState();
            if (!balanceLoaded) return showStatus("Could not refresh your wallet balance. Please try again.", "error");
            if (cachedEthBalance + 1e-12 < TOKEN_FEE_ETH) {
                return showStatus(`Insufficient demo ETH. Required ${TOKEN_FEE_ETH.toFixed(4)} ETH; available ${cachedEthBalance.toFixed(8)} ETH. Please top up first.`, "error");
            }
            document.getElementById("signPayloadSummary").innerText = `Minting ${amount} ESITH (Fee: ${TOKEN_FEE_ETH.toFixed(4)} demo ETH)`;
            document.getElementById("signModal").style.display = "flex";
        }
        function closeSignModal() { document.getElementById("signModal").style.display = "none"; }

        async function executeVirtualPayment() {
            if (!currentWallet) return showStatus("Connect a wallet before topping up.", "error");
            const ethAmount = Number(document.getElementById("gatewayEthAmount").value);
            if (!Number.isFinite(ethAmount) || ethAmount <= 0 || ethAmount > 100) {
                return showStatus("Enter a top-up amount between 0 and 100 demo ETH.", "error");
            }

            const payBtn = document.getElementById("payNowBtn");
            const terminal = document.getElementById("terminalLog");
            const originalText = payBtn.innerHTML;
            payBtn.disabled = true;
            payBtn.innerText = "Crediting demo ETH...";

            try {
                const res = await apiFetch('/api/topup-eth', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ wallet: currentWallet.address, amount_eth: ethAmount })
                });
                const data = await res.json();
                if (!res.ok || data.status !== "success") {
                    throw new Error(data.message || `Top-up failed (${res.status}).`);
                }

                cachedEthBalance = Number(data.new_eth_balance);
                document.getElementById("ethBalanceDisplay").innerText = `${cachedEthBalance.toFixed(4)} ETH`;
                terminal.innerHTML += `<br>[SUCCESS] Added ${ethAmount.toFixed(4)} demo ETH. New balance: ${cachedEthBalance.toFixed(4)} ETH.`;
                closeGatewayModal();
                await syncDatabaseState();
                playSuccessChime();
                try { confetti({ particleCount: 90, spread: 70, origin: { y: 0.6 } }); } catch(e) {}
                showStatus(`Top-up successful: ${ethAmount.toFixed(4)} demo ETH added. Balance: ${cachedEthBalance.toFixed(4)} ETH.`, "success");
            } catch (error) {
                console.error("Top-up failed:", error);
                terminal.innerHTML += `<br>[ERROR] ${error.message}`;
                showStatus(error.message || "Top-up failed. Check the backend and try again.", "error");
            } finally {
                payBtn.disabled = false;
                payBtn.innerHTML = originalText;
                updateGatewayUsdTotal();
            }
        }


        async function executeSignedMint() {
            if (!currentWallet) return showStatus("Connect a wallet first.", "error");
            const amount = Number(document.getElementById("tokenAmount").value);
            if (!Number.isFinite(amount) || amount <= 0) return showStatus("Enter a valid mint quantity.", "error");

            const signBtn = document.getElementById("signConfirmBtn");
            signBtn.disabled = true;
            signBtn.innerText = "Processing...";

            try {
                // Re-check balance on the server immediately before attempting the mint.
                const balanceLoaded = await syncDatabaseState();
                if (!balanceLoaded) throw new Error("Could not refresh wallet balance. Try again.");
                if (cachedEthBalance + 1e-12 < TOKEN_FEE_ETH) {
                    throw new Error(`Insufficient demo ETH. Required ${TOKEN_FEE_ETH.toFixed(4)} ETH; available ${cachedEthBalance.toFixed(8)} ETH.`);
                }

                const simTxHash = "0xSIM_MINT_" + crypto.randomUUID().replaceAll("-", "");
                const res = await apiFetch('/api/verify-transaction', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ txHash: simTxHash, wallet: currentWallet.address, amount: amount, txType: "MINT" })
                });
                const data = await res.json();
                if (!res.ok || data.status !== "success") {
                    throw new Error(data.message || `Mint failed (${res.status}).`);
                }

                closeSignModal();
                await syncDatabaseState();
                playSuccessChime();
                try { confetti({ particleCount: 70, spread: 60, origin: { y: 0.6 } }); } catch(e) {}
                showStatus(`Successfully recorded mint of ${amount} ESITH. Remaining demo ETH: ${cachedEthBalance.toFixed(4)} ETH.`, "success");
            } catch (error) {
                console.error("Mint failed:", error);
                showStatus(error.message || "Mint failed. Please try again.", "error");
            } finally {
                signBtn.disabled = false;
                signBtn.innerText = "Sign & Broadcast";
            }
        }


        async function generateTestRecipient() {
            const testWallet = ethers.Wallet.createRandom();
            document.getElementById("recipientAddress").value = testWallet.address;
            await apiFetch('/api/register-wallet', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ address: testWallet.address })
            });
            alert(`Test wallet generated: ${testWallet.address}\n\nPrivate key:\n${testWallet.privateKey}`);
        }

        function switchTab(tab) {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.getElementById('transferTab').style.display = tab === 'transfer' ? 'block' : 'none';
            document.getElementById('historyTab').style.display = tab === 'history' ? 'block' : 'none';
            event.target.classList.add('active');
        }

        function showStatus(msg, type="info") {
            const el = document.getElementById("statusMessage");
            el.style.display = "block";
            el.style.background = type === "success" ? "rgba(16, 185, 129, 0.15)" : (type === "error" ? "rgba(239, 68, 68, 0.15)" : "rgba(99, 102, 241, 0.15)");
            el.style.color = type === "success" ? "#34d399" : (type === "error" ? "#fca5a5" : "#818cf8");
            el.innerText = msg;
        }


        const projectSlides = [
            {
                kicker:"01 · THE VISION",
                title:"Introducing the ESITH Protocol",
                body:"A learning-focused token launchpad interface that brings together wallet access, token balances, transfers and transaction records in one dashboard.",
                points:[["Wallet experience","Create or import an Ethereum-compatible wallet."],["Token workflow","Explore minting and peer-to-peer transfer flows."],["Project dashboard","Review balances and transaction history."]]
            },
            {
                kicker:"02 · CRYPTOGRAPHY",
                title:"Your wallet is your identity",
                body:"An Ethereum wallet is controlled by a private key. The key authorizes signatures; the public address is derived from it and can be shared to receive assets.",
                points:[["Private key","Secret credential. Never share it or send it to the project API."],["Public address","A shareable identifier for receiving assets."],["Digital signature","Proves authorization without revealing the private key."]]
            },
            {
                kicker:"03 · BLOCKCHAIN",
                title:"A shared, tamper-resistant ledger",
                body:"A blockchain groups transactions into ordered blocks. Network participants validate and replicate the ledger, making confirmed history difficult to alter.",
                visual:["Wallet A","Signed transaction","Network ledger","Wallet B"]
            },
            {
                kicker:"04 · NETWORK",
                title:"How the application connects",
                body:"The frontend uses ethers.js for wallet utilities and calls a Flask API. The backend uses Web3.py and an Ethereum Sepolia RPC endpoint to check network connectivity.",
                visual:["Browser UI","Flask API","SQLite records","Sepolia RPC"]
            },
            {
                kicker:"05 · THE WORKFLOW",
                title:"From wallet to transaction record",
                body:"The current demo registers a wallet, reads its stored balance, and records mint/transfer activity in the application database. The interface refreshes the dashboard after each action.",
                points:[["Connect","Generate or import a wallet."],["Interact","Choose a mint amount or recipient."],["Record","Backend stores a transaction record."],["Review","History and balances refresh."]]
            },
            {
                kicker:"06 · SECURITY",
                title:"Protect the keys. Verify the transactions.",
                body:"The platform is publicly accessible: visitors do not need an administrator API password. Each person connects or restores their own wallet. A wallet recovery private key belongs only to its owner and must never be shared with the server.",
                points:[["Open platform","No project-wide API secret or access password is required."],["Wallet recovery","Users restore their own wallet with its private key. Never send that key to the backend."],["Production hardening","Use HTTPS, secure wallet signing, rate limits, validation and audited smart contracts."]]
            },
            {
                kicker:"07 · CURRENT STATUS",
                title:"A working prototype — not yet on-chain token issuance",
                body:"Important technical distinction: this version creates SIM_MINT / SIM_SEND hashes and stores records in SQLite. The top-up is simulated, and the block number is a placeholder. It does not yet broadcast a real smart-contract mint or transfer.",
                points:[["What works in the demo","Wallet UI, API routes, database history and simulated flows."],["Next milestone","Deploy and verify an ERC-20 contract, then submit and confirm real Sepolia transactions."],["Before launch","Add tests, access controls, monitoring and security review."]]
            }
        ];

        let activeSlide = 0;
        function renderSlide() {
            const slide = projectSlides[activeSlide];
            const content = document.getElementById("slideContent");
            const points = slide.points ? `<div class="slide-points">${slide.points.map(p => `<div class="slide-point"><b>${p[0]}</b>${p[1]}</div>`).join("")}</div>` : "";
            const visual = slide.visual ? `<div class="slide-visual">${slide.visual.map((v,i) => `<div class="node">${v}</div>${i < slide.visual.length-1 ? '<span style="color:#64748b;font-size:1.2rem">→</span>' : ''}`).join("")}</div>` : "";
            content.innerHTML = `<div class="slide-kicker">${slide.kicker}</div><h2>${slide.title}</h2><p>${slide.body}</p>${points}${visual}`;
            document.getElementById("slideCounter").textContent = `${activeSlide+1} / ${projectSlides.length}`;
            document.getElementById("slideProgress").style.width = `${((activeSlide+1)/projectSlides.length)*100}%`;
        }
        function openPresentation() {
            activeSlide = 0;
            renderSlide();
            document.getElementById("presentationOverlay").style.display = "flex";
        }
        function closePresentation() { document.getElementById("presentationOverlay").style.display = "none"; }
        function nextSlide() { activeSlide = (activeSlide + 1) % projectSlides.length; renderSlide(); }
        function previousSlide() { activeSlide = (activeSlide - 1 + projectSlides.length) % projectSlides.length; renderSlide(); }
        document.addEventListener("keydown", e => {
            if (document.getElementById("presentationOverlay").style.display === "flex") {
                if (e.key === "ArrowRight") nextSlide();
                if (e.key === "ArrowLeft") previousSlide();
                if (e.key === "Escape") closePresentation();
            }
        });

        document.getElementById("sendButton").addEventListener("click", async () => {
            const recipient = document.getElementById("recipientAddress").value.trim();
            const amount = parseFloat(document.getElementById("transferAmount").value);

            if (!ethers.isAddress(recipient)) return alert("Enter valid recipient address.");
            if (!amount || amount <= 0) return alert("Enter valid amount.");
            if (amount > cachedEsithBalance) return alert(`Insufficient ESITH balance.`);

            const simTxHash = "0xSIM_SEND_" + Math.random().toString(16).substring(2);
            await apiFetch('/api/verify-transaction', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ txHash: simTxHash, wallet: currentWallet.address, amount: amount, txType: "TRANSFER", recipient: recipient })
            });

            playSuccessChime();
            try { confetti({ particleCount: 70, spread: 60, origin: { y: 0.6 } }); } catch(e){}
            showStatus(`Transferred ${amount} ESITH live!`, "success");
            await syncDatabaseState();
        });
    </script>
