import os
from datetime import datetime
from flask import Flask, request, jsonify, send_from_directory
from flask_cors import CORS
from sqlalchemy import create_engine, Column, Integer, String, Float, DateTime, or_
from sqlalchemy.ext.declarative import declarative_base
from sqlalchemy.orm import sessionmaker, Session
from web3 import Web3
from web3.exceptions import TransactionNotFound

# -------------------------------------------------------------------
# 1. DATABASE CONFIGURATION & ORM MODELS
# -------------------------------------------------------------------
DATABASE_URL = os.getenv("DATABASE_URL", "sqlite:///./esith_launchpad.db")

engine = create_engine(
    DATABASE_URL, 
    connect_args={"check_same_thread": False} if "sqlite" in DATABASE_URL else {}
)
SessionLocal = sessionmaker(autocommit=False, autoflush=False, bind=engine)
Base = declarative_base()


class TransactionRecord(Base):
    __tablename__ = "transactions"

    id = Column(Integer, primary_key=True, index=True)
    tx_hash = Column(String(66), unique=True, index=True, nullable=False)
    sender_address = Column(String(42), index=True, nullable=False)
    recipient_address = Column(String(42), index=True, nullable=True)
    tx_type = Column(String(20), nullable=False)  # "MINT" or "TRANSFER"
    amount_tokens = Column(Float, nullable=False)
    cost_eth = Column(Float, nullable=True)
    block_number = Column(Integer, nullable=True)
    created_at = Column(DateTime, default=datetime.utcnow)


class WebWallet(Base):
    __tablename__ = "wallets"

    id = Column(Integer, primary_key=True, index=True)
    address = Column(String(42), unique=True, index=True, nullable=False)
    eth_balance = Column(Float, default=0.5)  # Simulated test ETH balance
    created_at = Column(DateTime, default=datetime.utcnow)


Base.metadata.create_all(bind=engine)


# -------------------------------------------------------------------
# 2. WEB3 RPC & FLASK APP INITIALIZATION
# -------------------------------------------------------------------
app = Flask(__name__)
CORS(app)

RPC_URL = os.getenv("ETH_RPC_URL", "https://ethereum-sepolia-rpc.publicnode.com")
w3 = Web3(Web3.HTTPProvider(RPC_URL, request_kwargs={'timeout': 10}))


def get_db() -> Session:
    return SessionLocal()


def ensure_wallet_registered(db: Session, address: str):
    if not address or not w3.is_address(address):
        return
    addr_clean = address.lower().strip()
    existing = db.query(WebWallet).filter(WebWallet.address == addr_clean).first()
    if not existing:
        db.add(WebWallet(address=addr_clean, eth_balance=0.5))
        db.commit()


# -------------------------------------------------------------------
# 3. FRONTEND & HEALTH ROUTES
# -------------------------------------------------------------------
@app.route("/", methods=["GET"])
def serve_frontend():
    if os.path.exists("esith.html"):
        return send_from_directory('.', 'esith.html')
    return jsonify({"error": "esith.html not found in server directory."}), 404


@app.route("/api/health", methods=["GET"])
def health_check():
    is_connected = w3.is_connected()
    chain_id = None
    if is_connected:
        try:
            chain_id = w3.eth.chain_id
        except Exception:
            pass

    return jsonify({
        "status": "online",
        "service": "ESITH Protocol Backend",
        "blockchain_connected": is_connected,
        "chain_id": chain_id,
        "rpc_url": RPC_URL
    }), 200


# -------------------------------------------------------------------
# 4. DATABASE API ENDPOINTS
# -------------------------------------------------------------------
@app.route("/api/wallet-state/<wallet_address>", methods=["GET"])
def get_wallet_state(wallet_address: str):
    if not w3.is_address(wallet_address):
        return jsonify({"status": "error", "message": "Invalid address format"}), 400

    db = get_db()
    try:
        addr = wallet_address.lower().strip()
        ensure_wallet_registered(db, addr)

        wallet_obj = db.query(WebWallet).filter(WebWallet.address == addr).first()
        eth_bal = wallet_obj.eth_balance if wallet_obj else 0.5

        records = db.query(TransactionRecord).filter(
            or_(
                TransactionRecord.sender_address == addr,
                TransactionRecord.recipient_address == addr
            )
        ).order_by(TransactionRecord.created_at.desc()).all()

        total_tokens = 0.0
        history = []
        for tx in records:
            if tx.tx_type == "MINT" and tx.sender_address == addr:
                total_tokens += tx.amount_tokens
            elif tx.tx_type == "TRANSFER":
                if tx.sender_address == addr:
                    total_tokens -= tx.amount_tokens
                if tx.recipient_address == addr:
                    total_tokens += tx.amount_tokens

            is_incoming = (tx.recipient_address == addr) if tx.tx_type == "TRANSFER" else True
            history.append({
                "tx_hash": tx.tx_hash,
                "tx_type": tx.tx_type,
                "amount": tx.amount_tokens,
                "cost_eth": tx.cost_eth,
                "is_incoming": is_incoming,
                "counterparty": tx.recipient_address if tx.sender_address == addr else tx.sender_address,
                "block_number": tx.block_number,
                "created_at": tx.created_at.isoformat()
            })

        return jsonify({
            "status": "success",
            "wallet": addr,
            "eth_balance": eth_bal,
            "esith_balance": max(0.0, total_tokens),
            "history": history
        }), 200
    finally:
        db.close()


@app.route("/api/topup-eth", methods=["POST"])
def topup_eth():
    """Adds simulated purchased ETH to the user's account."""
    data = request.get_json() or {}
    wallet_address = data.get("wallet") or data.get("wallet_address")
    amount_eth = float(data.get("amount_eth", 1.0))

    if not wallet_address:
        return jsonify({"status": "error", "message": "Wallet required."}), 400

    db = get_db()
    try:
        addr = wallet_address.lower().strip()
        wallet_obj = db.query(WebWallet).filter(WebWallet.address == addr).first()
        if not wallet_obj:
            wallet_obj = WebWallet(address=addr, eth_balance=amount_eth)
            db.add(wallet_obj)
        else:
            wallet_obj.eth_balance += amount_eth
        db.commit()
        return jsonify({"status": "success", "new_eth_balance": wallet_obj.eth_balance}), 200
    except Exception as e:
        db.rollback()
        return jsonify({"status": "error", "message": str(e)}), 500
    finally:
        db.close()


@app.route("/api/verify-transaction", methods=["POST"])
def verify_transaction():
    data = request.get_json() or {}
    tx_hash = data.get("txHash") or data.get("tx_hash")
    wallet_address = data.get("wallet") or data.get("wallet_address")
    amount = data.get("amount")
    tx_type = data.get("txType") or data.get("tx_type", "MINT")
    recipient = data.get("recipient")

    if not tx_hash or not wallet_address or amount is None:
        return jsonify({"status": "error", "message": "Missing required parameters."}), 400

    try:
        amount = float(amount)
        if amount <= 0:
            raise ValueError()
    except ValueError:
        return jsonify({"status": "error", "message": "Invalid amount."}), 400

    db = get_db()
    try:
        sender_clean = wallet_address.lower().strip()
        recipient_clean = recipient.lower().strip() if recipient else None

        existing_tx = db.query(TransactionRecord).filter(TransactionRecord.tx_hash == tx_hash).first()
        if existing_tx:
            return jsonify({"status": "success", "message": "Already logged.", "tx_id": existing_tx.id}), 200

        ensure_wallet_registered(db, sender_clean)
        if recipient_clean:
            ensure_wallet_registered(db, recipient_clean)

        # Deduct 0.0001 ETH fee if minting
        if tx_type == "MINT":
            wallet_obj = db.query(WebWallet).filter(WebWallet.address == sender_clean).first()
            if wallet_obj:
                if wallet_obj.eth_balance < 0.0001:
                    return jsonify({"status": "error", "message": "Insufficient ETH balance to cover 0.0001 ETH fee. Please use Gateway Top-Up!"}), 400
                wallet_obj.eth_balance -= 0.0001

        db_record = TransactionRecord(
            tx_hash=tx_hash,
            sender_address=sender_clean,
            recipient_address=recipient_clean,
            tx_type=str(tx_type).upper(),
            amount_tokens=amount,
            cost_eth=0.0001 if tx_type == "MINT" else 0.0,
            block_number=999999
        )
        db.add(db_record)
        db.commit()

        return jsonify({"status": "success", "message": "Transaction recorded successfully.", "tx_id": db_record.id}), 200
    except Exception as e:
        db.rollback()
        return jsonify({"status": "error", "message": str(e)}), 500
    finally:
        db.close()


@app.route("/api/register-wallet", methods=["POST"])
def register_wallet():
    data = request.get_json() or {}
    address = data.get("address") or data.get("wallet")
    if not address:
        return jsonify({"status": "error", "message": "Address required."}), 400

    addr_clean = address.lower().strip()
    db = get_db()
    try:
        existing = db.query(WebWallet).filter(WebWallet.address == addr_clean).first()
        if not existing:
            db.add(WebWallet(address=addr_clean, eth_balance=0.5))
            db.commit()
            return jsonify({"status": "created", "address": addr_clean}), 201
        return jsonify({"status": "exists", "address": addr_clean}), 200
    finally:
        db.close()


